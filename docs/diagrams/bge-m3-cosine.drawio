<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" version="31.1.8"><diagram id="cosine" name="余弦相似度计算"><mxGraphModel dx="1220" dy="970" page="1" pageWidth="1220" pageHeight="970" background="#ffffff"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="问题向量与资料向量：余弦相似度计算" style="fontFamily=PingFang SC;fontColor=#253247;fontSize=15;whiteSpace=wrap;html=0;verticalAlign=middle;align=center;text;strokeColor=none;fillColor=none;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="25" y="20" width="1170" height="45" as="geometry" /></mxCell><mxCell id="actual-label" value="实际计算：q 与 d 均为 BGE-M3 输出的 1024 维向量" style="fontFamily=PingFang SC;fontColor=#253247;fontSize=15;whiteSpace=wrap;html=0;verticalAlign=middle;align=center;text;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="85" width="1150" height="35" as="geometry" /></mxCell><mxCell id="inputs" value="输入两个向量&#10;问题 q、某段资料 d" style="fontFamily=PingFang SC;fontColor=#253247;fontSize=15;whiteSpace=wrap;html=0;verticalAlign=middle;align=center;rounded=1;strokeColor=#cbd5e1;fillColor=#f8fafc;" vertex="1" parent="1"><mxGeometry x="30" y="140" width="215" height="90" as="geometry" /></mxCell><mxCell id="dot-norm" value="分别计算&#10;点积 q·d、长度 ‖q‖ 和 ‖d‖" style="fontFamily=PingFang SC;fontColor=#253247;fontSize=15;whiteSpace=wrap;html=0;verticalAlign=middle;align=center;rounded=1;strokeColor=#cbd5e1;fillColor=#f8fafc;" vertex="1" parent="1"><mxGeometry x="265" y="140" width="215" height="90" as="geometry" /></mxCell><mxCell id="step-1" style="strokeColor=#64748b;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="245" y="185" as="sourcePoint" /><mxPoint x="265" y="185" as="targetPoint" /></mxGeometry></mxCell><mxCell id="divide" value="归一化点积&#10;(q·d) / (‖q‖ × ‖d‖)" style="fontFamily=PingFang SC;fontColor=#253247;fontSize=15;whiteSpace=wrap;html=0;verticalAlign=middle;align=center;rounded=1;strokeColor=#2563eb;fillColor=#eff6ff;" vertex="1" parent="1"><mxGeometry x="500" y="140" width="215" height="90" as="geometry" /></mxCell><mxCell id="step-2" style="strokeColor=#64748b;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="480" y="185" as="sourcePoint" /><mxPoint x="500" y="185" as="targetPoint" /></mxGeometry></mxCell><mxCell id="score" value="得到一个分数&#10;即 cos(θ)，范围 [−1, 1]" style="fontFamily=PingFang SC;fontColor=#253247;fontSize=15;whiteSpace=wrap;html=0;verticalAlign=middle;align=center;rounded=1;strokeColor=#cbd5e1;fillColor=#f8fafc;" vertex="1" parent="1"><mxGeometry x="735" y="140" width="215" height="90" as="geometry" /></mxCell><mxCell id="step-3" style="strokeColor=#64748b;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="715" y="185" as="sourcePoint" /><mxPoint x="735" y="185" as="targetPoint" /></mxGeometry></mxCell><mxCell id="rank" value="对每段资料重复&#10;按分数降序排列" style="fontFamily=PingFang SC;fontColor=#253247;fontSize=15;whiteSpace=wrap;html=0;verticalAlign=middle;align=center;rounded=1;strokeColor=#cbd5e1;fillColor=#f8fafc;" vertex="1" parent="1"><mxGeometry x="970" y="140" width="215" height="90" as="geometry" /></mxCell><mxCell id="step-4" style="strokeColor=#64748b;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="950" y="185" as="sourcePoint" /><mxPoint x="970" y="185" as="targetPoint" /></mxGeometry></mxCell><mxCell id="formula" value="q·d = Σ(qᵢ × dᵢ)     ‖q‖ = √Σqᵢ²     ‖d‖ = √Σdᵢ²     （i = 1 … 1024）" style="fontFamily=PingFang SC;fontColor=#253247;fontSize=15;whiteSpace=wrap;html=0;verticalAlign=middle;align=center;text;strokeColor=none;fillColor=none;fontSize=17;" vertex="1" parent="1"><mxGeometry x="30" y="250" width="1150" height="45" as="geometry" /></mxCell><mxCell id="example-label" value="二维数学示例：用于展开计算；不是模型实测，也不是 1024 维向量的投影" style="fontFamily=PingFang SC;fontColor=#253247;fontSize=15;whiteSpace=wrap;html=0;verticalAlign=middle;align=center;text;strokeColor=none;fillColor=none;align=left;fontStyle=1;fontColor=#2563eb;" vertex="1" parent="1"><mxGeometry x="30" y="325" width="1150" height="40" as="geometry" /></mxCell><mxCell id="geo-panel" value="" style="fontFamily=PingFang SC;fontColor=#253247;fontSize=15;whiteSpace=wrap;html=0;verticalAlign=middle;align=center;rounded=1;fillColor=#f8fafc;strokeColor=#e2e8f0;" vertex="1" parent="1"><mxGeometry x="30" y="390" width="450" height="415" as="geometry" /></mxCell><mxCell id="geo-title" value="方向关系" style="fontFamily=PingFang SC;fontColor=#253247;fontSize=15;whiteSpace=wrap;html=0;verticalAlign=middle;align=center;text;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="45" y="405" width="420" height="35" as="geometry" /></mxCell><mxCell id="axis-x" style="strokeColor=#94a3b8;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="105" y="720" as="sourcePoint" /><mxPoint x="430" y="720" as="targetPoint" /></mxGeometry></mxCell><mxCell id="axis-y" style="strokeColor=#94a3b8;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="755" as="sourcePoint" /><mxPoint x="140" y="470" as="targetPoint" /></mxGeometry></mxCell><mxCell id="x-label" value="x" style="fontFamily=PingFang SC;fontColor=#253247;fontSize=15;whiteSpace=wrap;html=0;verticalAlign=middle;align=center;text;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="425" y="720" width="25" height="25" as="geometry" /></mxCell><mxCell id="y-label" value="y" style="fontFamily=PingFang SC;fontColor=#253247;fontSize=15;whiteSpace=wrap;html=0;verticalAlign=middle;align=center;text;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="115" y="455" width="25" height="25" as="geometry" /></mxCell><mxCell id="origin" value="0" style="fontFamily=PingFang SC;fontColor=#253247;fontSize=15;whiteSpace=wrap;html=0;verticalAlign=middle;align=center;text;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="110" y="725" width="25" height="25" as="geometry" /></mxCell><mxCell id="q-ray" style="strokeColor=#2563eb;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="720" as="sourcePoint" /><mxPoint x="230" y="540" as="targetPoint" /></mxGeometry></mxCell><mxCell id="d-ray" style="strokeColor=#0f766e;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="720" as="sourcePoint" /><mxPoint x="320" y="630" as="targetPoint" /></mxGeometry></mxCell><mxCell id="q-label" value="q = (1, 2)" style="fontFamily=PingFang SC;fontColor=#253247;fontSize=15;whiteSpace=wrap;html=0;verticalAlign=middle;align=center;text;strokeColor=none;fillColor=none;fontColor=#2563eb;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="200" y="490" width="190" height="35" as="geometry" /></mxCell><mxCell id="d-label" value="dA = (2, 1)" style="fontFamily=PingFang SC;fontColor=#253247;fontSize=15;whiteSpace=wrap;html=0;verticalAlign=middle;align=center;text;strokeColor=none;fillColor=none;fontColor=#0f766e;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="290" y="585" width="170" height="35" as="geometry" /></mxCell><mxCell id="theta" value="θ ≈ 36.87°" style="fontFamily=PingFang SC;fontColor=#253247;fontSize=15;whiteSpace=wrap;html=0;verticalAlign=middle;align=center;text;strokeColor=none;fillColor=none;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="200" y="610" width="120" height="30" as="geometry" /></mxCell><mxCell id="geometric-note" value="比较方向：夹角越小，cos(θ) 越大" style="fontFamily=PingFang SC;fontColor=#253247;fontSize=15;whiteSpace=wrap;html=0;verticalAlign=middle;align=center;text;strokeColor=none;fillColor=none;fontSize=14;" vertex="1" parent="1"><mxGeometry x="50" y="760" width="410" height="30" as="geometry" /></mxCell><mxCell id="numeric-panel" value="" style="fontFamily=PingFang SC;fontColor=#253247;fontSize=15;whiteSpace=wrap;html=0;verticalAlign=middle;align=center;rounded=1;fillColor=#ffffff;strokeColor=#e2e8f0;" vertex="1" parent="1"><mxGeometry x="510" y="390" width="670" height="415" as="geometry" /></mxCell><mxCell id="numeric-title" value="同一对向量的数值展开" style="fontFamily=PingFang SC;fontColor=#253247;fontSize=15;whiteSpace=wrap;html=0;verticalAlign=middle;align=center;text;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="530" y="405" width="630" height="35" as="geometry" /></mxCell><mxCell id="multiply" value="1. 点积：q·dA = 1×2 + 2×1 = 4" style="fontFamily=PingFang SC;fontColor=#253247;fontSize=15;whiteSpace=wrap;html=0;verticalAlign=middle;align=center;text;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="540" y="460" width="600" height="40" as="geometry" /></mxCell><mxCell id="norm-q" value="2. 问题向量长度：‖q‖ = √(1²+2²) = √5" style="fontFamily=PingFang SC;fontColor=#253247;fontSize=15;whiteSpace=wrap;html=0;verticalAlign=middle;align=center;text;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="540" y="515" width="600" height="40" as="geometry" /></mxCell><mxCell id="norm-d" value="3. 资料向量长度：‖dA‖ = √(2²+1²) = √5" style="fontFamily=PingFang SC;fontColor=#253247;fontSize=15;whiteSpace=wrap;html=0;verticalAlign=middle;align=center;text;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="540" y="570" width="600" height="40" as="geometry" /></mxCell><mxCell id="numeric-score" value="4. cos(q, dA) = 4 / (√5 × √5) = 0.8" style="fontFamily=PingFang SC;fontColor=#253247;fontSize=15;whiteSpace=wrap;html=0;verticalAlign=middle;align=center;rounded=1;strokeColor=#2563eb;fillColor=#eff6ff;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="540" y="635" width="610" height="65" as="geometry" /></mxCell><mxCell id="rank-example" value="同一 q 下的数学示例排名：&#10;A (2,1)：0.8000  &gt;  B (1,0)：0.4472  &gt;  C (−2,1)：0.0000" style="fontFamily=PingFang SC;fontColor=#253247;fontSize=15;whiteSpace=wrap;html=0;verticalAlign=middle;align=center;text;strokeColor=none;fillColor=none;fontSize=15;" vertex="1" parent="1"><mxGeometry x="535" y="720" width="625" height="65" as="geometry" /></mxCell><mxCell id="note" value="长度归一化用于消除向量尺度影响；零向量无法计算余弦。0.8 表示方向接近程度，不表示 80% 正确。" style="fontFamily=PingFang SC;fontColor=#253247;fontSize=15;whiteSpace=wrap;html=0;verticalAlign=middle;align=center;text;strokeColor=none;fillColor=none;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="840" width="1150" height="50" as="geometry" /></mxCell><mxCell id="scope" value="BGE-M3 负责输出向量；点积、长度计算和排序均由本地 Python 执行，不再调用模型。" style="fontFamily=PingFang SC;fontColor=#253247;fontSize=15;whiteSpace=wrap;html=0;verticalAlign=middle;align=center;text;strokeColor=none;fillColor=none;fontSize=14;fontColor=#2563eb;" vertex="1" parent="1"><mxGeometry x="30" y="900" width="1150" height="35" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>